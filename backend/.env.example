# SQLite is relative to the backend directory when running the commands in the README.
DATABASE_URL=sqlite:///./data/disruptioniq.db
ENVIRONMENT=development
# Explicit local development origins only; use a specific deployment origin in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional Modular AI Assistance Configuration
AI_ENABLED=false
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_RETRIES=1

# Authentication, Security & RBAC Configuration
# In production, set AUTH_REQUIRED=true to reject all unauthenticated requests
AUTH_REQUIRED=false
JWT_SECRET_KEY=replace-with-cryptographically-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PROCUREMENT_APPROVAL_THRESHOLD_USD=50000.0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60
